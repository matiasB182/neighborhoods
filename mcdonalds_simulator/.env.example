REDSHIFT_HOST=your-cluster.xxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=your_database
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password

# ── Tablas fuente ────────────────────────────────────────────────
TABLE_FORECAST=stg.forecast
TABLE_FACT_VENTAS=stg.fact_ventas
TABLE_DIM_ARTICULO=stg.dim_articulo_venta
TABLE_DIM_RESTAURANTES=stg.dim_restaurantes

# ── Tablas cargadas desde Excel ──────────────────────────────────
TABLE_PRECIO_PRODUCTOS=mcd.precio_productos
TABLE_PROMOCIONES=mcd.promociones
TABLE_LANZAMIENTOS=mcd.lanzamientos
TABLE_APERTURA_RESTAURANTES=mcd.apertura_restaurantes
TABLE_COMPETENCIA=mcd.competencia

# ── Tablas generadas por el simulador ───────────────────────────
TABLE_ELASTICIDADES=mcd.whatif_elasticidades
TABLE_RESULTADOS=mcd.whatif_resultados
