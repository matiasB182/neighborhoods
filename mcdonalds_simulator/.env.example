REDSHIFT_HOST=your-cluster.xxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=your_database
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password
REDSHIFT_SCHEMA=mcd

# Nombre completo de la tabla de forecast (schema.tabla o solo tabla si está en REDSHIFT_SCHEMA)
# Ejemplo: stg.forecast_mensual  o simplemente  forecast
FORECAST_TABLE=forecast
