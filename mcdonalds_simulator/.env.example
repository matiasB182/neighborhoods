# ═══════════════════════════════════════════════════════════════════════════
# Plantilla de variables de entorno del simulador.
# Copiar a `.env` y completar con los valores reales (NO commitear el .env).
# ═══════════════════════════════════════════════════════════════════════════

# ── Conexión Redshift ────────────────────────────────────────────
REDSHIFT_HOST=tu-cluster.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=mcdonalds
REDSHIFT_USER=usuario
REDSHIFT_PASSWORD=contraseña

# ── Tablas fuente ────────────────────────────────────────────────
TABLE_FORECAST=forecasting.forecast_ventas_sucursal
TABLE_FACT_VENTAS=stg.fact_ventas
TABLE_DIM_ARTICULO=stg.dim_articulo_venta
TABLE_DIM_RESTAURANTES=stg.dim_restaurantes

# ── Tablas cargadas desde Excel ──────────────────────────────────
TABLE_PRECIO_PRODUCTOS=simulacion.precio_productos
TABLE_PROMOCIONES=simulacion.promociones
TABLE_LANZAMIENTOS=simulacion.lanzamientos
TABLE_APERTURA_RESTAURANTES=simulacion.apertura_restaurantes
TABLE_COMPETENCIA=simulacion.competencia

# ── Tablas generadas por el simulador ───────────────────────────
TABLE_ELASTICIDADES=simulacion.whatif_elasticidades
TABLE_RESULTADOS=simulacion.whatif_resultados

# ── Opcionales (tienen default en core/db.py si se omiten) ───────
# TABLE_LOCALES_DIMENSION=simulacion.locales_dimension
# TABLE_UPLIFTS_MEDIDOS=simulacion.uplifts_medidos
# TABLE_SENSIBILIDAD_CLIMA=simulacion.sensibilidad_clima
# TABLE_CLIMA_NORMALES=simulacion.clima_normales
# TABLE_IMPACTO_APERTURAS=simulacion.impacto_aperturas
# TABLE_RAMPUP_APERTURAS=simulacion.rampup_aperturas
# TABLE_CURVAS_LANZAMIENTO=simulacion.curvas_lanzamiento
